# Europejskie API LLM (np. Mistral AI / Scaleway UE / OVHcloud UE)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=ministral-3b-latest
LLM_TIMEOUT_SECONDS=30.0
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=1
LLM_USE_STRICT_SCHEMA=true
LLM_STRICT_CHECKSUMS=false
# Tryb ekstrakcji: "section_swarm" (domyślny dla odwołania) lub "single" (1-shot)
LLM_EXTRACTION_MODE=section_swarm
